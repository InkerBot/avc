#!/bin/sh
set -eu
converter_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export PYTHONHOME="$converter_root/python"
export PYTHONPATH="$converter_root/site-packages:$converter_root"
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
exec "$converter_root/python/bin/python3" -s "$converter_root/convert_pth.py" "$@"
